{
  "rewrites": [
    {
      "source": "/profile-name-search",
      "destination": "/profile-name-search.html"
    },
    {
      "source": "/album-creator",
      "destination": "/album-creator.html"
    },
    {
      "source": "/album-creator/create",
      "destination": "/album-creator/create.html"
    },
    {
      "source": "/preview/safety",
      "destination": "/preview/safety.html"
    },
    {
      "source": "/support",
      "destination": "/support.html"
    },
    {
      "source": "/my-labs",
      "destination": "/my-labs.html"
    },
    {
      "source": "/hookup-safety-check",
      "destination": "/hookup-safety-check.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/legal-notice",
      "destination": "/legal-notice.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/guides",
      "destination": "/guides.html"
    },
    {
      "source": "/guides/:slug",
      "destination": "/guides/:slug.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/profile-hunter",
      "destination": "/profile-name-search",
      "permanent": true
    },
    {
      "source": "/profile-hunter.html",
      "destination": "/profile-name-search",
      "permanent": true
    },
    {
      "source": "/labs",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/tools",
      "destination": "/#tools",
      "permanent": false
    },
    {
      "source": "/my-tools",
      "destination": "/my-labs",
      "permanent": false
    },
    {
      "source": "/join/:code",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/landing",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/login",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/signup",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/explore",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/pro",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/pro.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/app",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/app.html",
      "destination": "/",
      "permanent": false
    }
  ]
}
