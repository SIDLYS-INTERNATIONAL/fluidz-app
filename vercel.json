{
  "rewrites": [
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/legal-notice",
      "destination": "/legal-notice.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/labs/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/profile-name-search",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/profile-name-search.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/profile-hunter",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/profile-hunter.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/labs",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/tools",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/my-tools",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/join/:code",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/landing",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/login",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/signup",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/explore",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/pro",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/pro.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/app",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/app.html",
      "destination": "/",
      "permanent": false
    }
  ]
}
